# ==============================================================================
# AIVEN CLOUD MYSQL CONFIGURATION
# Copy this file to .env and fill in your actual credentials from Aiven Console
# ==============================================================================

# Aiven Service URI format:
# DB_URL=jdbc:mysql://<HOST>:<PORT>/defaultdb?sslmode=REQUIRED&serverTimezone=UTC
DB_URL=jdbc:mysql://mysql-xxxxxxxx.aivencloud.com:12345/defaultdb?sslmode=REQUIRED&serverTimezone=UTC

# Aiven Database User (default is usually 'avnadmin')
DB_USERNAME=avnadmin

# Aiven Database Password
DB_PASSWORD=your_aiven_password_here

